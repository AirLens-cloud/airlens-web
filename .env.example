# AirLens web — env overrides (all optional; sensible defaults are baked into
# src/lib/config/dataSources.ts). Copy to .env.local for local overrides.

# HF public dataset repo (Robeedau/airlens-live) resolve base — live data primary.
VITE_HF_LIVE_BASE=https://huggingface.co/datasets/Robeedau/airlens-live/resolve/main

# Snapshot CDN override (pm25/pm10 fallback only) — default is the HF mirror
# (src/lib/config/dataSources.ts). The old joymin5655.github.io Pages CDN is
# retired (2026-09 org transfer — returns 404); set only to point elsewhere.
# VITE_SNAPSHOT_CDN_BASE=

# Community API Worker (keyless, 30-min cache) — Weather page proxy routes
# (/api/proxy/open-meteo-weather, /api/proxy/open-meteo-aq). Empty/unset means
# the Weather page renders an honest "not configured" state — no request is
# attempted against an empty base URL.
VITE_COMMUNITY_API_BASE=https://airlens.cloud

# Field Assistant Worker (workers/assistant/) — session issuance + SSE chat,
# RAG + intent classification + live-data (deployed A-4, baked default
# points at the live worker). Set VITE_ASSISTANT_API_BASE= (empty, not
# unset) to force ChatPanel's disabled "coming back soon" state instead (no
# scripted/fake conversation is ever rendered — Glass-box) — e.g. for a
# local build against a worker you haven't deployed yet.
VITE_ASSISTANT_API_BASE=

# Turnstile sitekey for the assistant session's bot-verification widget
# (src/lib/turnstile.ts) — a public value by design, safe to bake into the
# client bundle. Only needs overriding if the `airlens-assistant` widget
# (wrangler turnstile widget create) is ever recreated under a new sitekey.
VITE_TURNSTILE_SITE_KEY=
