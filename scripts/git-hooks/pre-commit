#!/usr/bin/env bash
# airlens-web git pre-commit hook — Layer 1 secret scan (gitleaks).
# Activated via: npm run setup-hooks   (sets core.hooksPath=scripts/git-hooks)
#
# Bypass (NOT recommended): git commit --no-verify
# CI Layer 2 (.github/workflows/ci.yml) re-runs gitleaks on the full diff.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
NC=$'\033[0m'

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact -v --config="$ROOT/gitleaks.toml" --no-banner; then
    echo "${RED}✗ gitleaks found secrets in staged changes — commit blocked.${NC}" >&2
    echo "  Bypass (emergency only): git commit --no-verify" >&2
    echo "  False-positive? Add to gitleaks.toml [allowlist] and document in PR." >&2
    exit 1
  fi
else
  # Fail closed, not open. This repo is public — a secret in a pushed commit
  # is exposed the moment it leaves this machine, before CI's `secret-scan`
  # job (required on main, but post-push) ever runs. Silently skipping here
  # would make the local hook a no-op exactly when it matters most.
  echo "${RED}✗ gitleaks not installed — commit blocked (this repo is public).${NC}" >&2
  echo "  Install: brew install gitleaks  (or https://github.com/gitleaks/gitleaks/releases)" >&2
  echo "  Bypass (emergency only, CI secret-scan still gates the merge): git commit --no-verify" >&2
  exit 1
fi

echo "${GREEN}✓ pre-commit checks passed${NC}" >&2
exit 0
