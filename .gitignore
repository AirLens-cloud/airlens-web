# dependencies
node_modules/

# build output
dist/
dist-ssr/

# env
.env
.env.local
.env.*.local
!.env.example

# wrangler local secrets. `workers/assistant/wrangler.toml` tells developers to
# put SESSION_HMAC_SECRET / TURNSTILE_SECRET / ADMIN_REINDEX_SECRET in a
# ".dev.vars file, gitignored" — which was not true until this line existed.
# HMAC secrets are random strings, so gitleaks' generic rules may not catch one.
.dev.vars
.dev.vars.*

# editor / OS
.DS_Store
*.local
.vscode/*
!.vscode/extensions.json
.idea/

# logs
*.log
npm-debug.log*

# cloudflare
.wrangler/

# test / coverage
coverage/
.gstack/

# agent-side local state — never belongs in the repo, and this repo is public,
# so a stray `git add -A` would publish it rather than merely commit it.
# These are all currently untracked; listing them here is what keeps that true.
.agent/
.serena/
.worktrees/

# static fallback data — regenerated by scripts/prefetch-fallback-data.mjs
# (npm run build). public/data/data_quality.json and countries-50m.json are
# real committed assets and stay tracked.
/public/data/current-pm25-grid.json
/public/data/predictions/
/public/data/weather/
